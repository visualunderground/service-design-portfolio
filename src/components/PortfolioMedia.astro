---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
const { src, alt, caption } = Astro.props;
const filename = src.split('/').pop();
if (!src.startsWith('/assets/') || !existsSync(resolve(process.cwd(), 'public', src.slice(1)))) throw new Error('Missing local portfolio image: ' + src);
const url = import.meta.env.BASE_URL.replace(/\/$/, '') + src.split('/').map(encodeURIComponent).join('/');
const hasCaption = caption || Astro.slots.has('default');
---
<figure><img loading="lazy" src={url} alt={alt ?? caption ?? filename.replace(/\.[^.]+$/, '').replaceAll('-', ' ')} />{hasCaption && <figcaption>{caption}<slot /></figcaption>}</figure>
